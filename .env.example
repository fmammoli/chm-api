# Security
CHM_API_KEY=replace-with-strong-random-secret
REQUIRE_API_KEY=true

# CORS/Hosts
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Limits
MAX_GEOJSON_BYTES=1000000
MAX_AOI_AREA_KM2=250000
MAX_VERTICES=50000
MAX_TILES_PER_REQUEST=128
DOWNLOAD_WORKERS=6
RATE_LIMIT_PER_MINUTE=30
