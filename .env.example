# Security
CHM_API_KEY=replace-with-strong-random-secret
REQUIRE_API_KEY=true

# CORS/Hosts
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Limits
MAX_GEOJSON_BYTES=1000000
MAX_AOI_AREA_KM2=1200
AOI_SQUARE_SIDE_KM=30
MAX_VERTICES=50000
MAX_TILES_PER_REQUEST=16
DOWNLOAD_WORKERS=2
MAX_CONCURRENT_CHM_JOBS=1
MAX_PENDING_CHM_JOBS=6
RATE_LIMIT_PER_MINUTE=30

# Landcover stats source
LANDCOVER_BASE_URL=https://www.bc-webgis.com/landcover-mapbiomas-pmtiles-values
LANDCOVER_URL_TEMPLATE={base_url}/{year}_landcover.pmtiles
# Optional explicit overrides for year-specific assets.
LANDCOVER_YEAR_1990_URL=
LANDCOVER_YEAR_2024_URL=
# Forest classes for GeoTIFF/COG workflows.
LANDCOVER_FOREST_CLASSES=[3,5,76]
LANDCOVER_PLANTED_FOREST_CLASSES=[]
# Forest colors for PMTiles PNG workflows (from QGIS legend).
# Keep only forest colors here; do not include oil-palm/plantation colors if they should count as non-forest.
LANDCOVER_FOREST_COLORS=["1f8d49"]
LANDCOVER_PMTILES_ZOOM=12

# AGB stats source
AGB_STATS_BASE_URL=https://www.bc-webgis.com/agb-ctrees-pmtiles-values
AGB_STATS_URL_TEMPLATE={base_url}/{year}_agb-ctrees.pmtiles

# CHM PMTiles source
CHM_STATS_PMTILES_URL=https://www.bc-webgis.com/chm-pmtiles/total_chm.pmtiles

# AGB stats scale factor for CTrees COG values (raw COG uses 10 => Mg/ha = raw/10)
AGB_STATS_SCALE_FACTOR=10

# Optional threat-map legend mapping extracted from mekar_raya.qgz
THREAT_MAP_LEGEND_MANIFEST_PATH=app/data/legends/mekar_raya_legend_manifest.json
# Threat-map frame source (colorized PMTiles)
THREAT_MAP_LANDCOVER_BASE_URL=https://www.bc-webgis.com/landcover-mapbiomas-pmtiles
THREAT_MAP_LANDCOVER_URL_TEMPLATE={base_url}/{year}_landcover.pmtiles
THREAT_MAP_LANDCOVER_YEAR_1990_URL=
THREAT_MAP_LANDCOVER_YEAR_2024_URL=
# Frames workflow can exceed 120s on low-resource machines; increase request timeout.
THREAT_MAP_REQUEST_TIMEOUT_SECONDS=240
